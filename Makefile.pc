# WIISP - compilación para PC (Linux/macOS/MSYS2), para depurar y probar
#
#   make -f Makefile.pc            -> build-pc/wiisp-cli
#   make -f Makefile.pc test       -> pruebas unitarias (con sanitizers)
#   make -f Makefile.pc eboot      -> build-pc/EBOOT.PBP de prueba (sintético)
#   make -f Makefile.pc cli-ppc    -> CLI para PowerPC (con qemu-ppc)
#   make -f Makefile.pc win        -> build-win/wiisp-cli.exe para Windows
#                                     (x86_64-w64-mingw32-gcc, sin DLLs)
#   make -f Makefile.pc test-ppc   -> pruebas en PowerPC big-endian (como el
#                                     Wii) con powerpc-linux-gnu-gcc + qemu-ppc

CC       ?= cc
OUT      ?= build-pc
CFLAGS   ?= -O1 -g
CFLAGS   += -std=gnu11 -fwrapv -Wall -Wextra -Wno-unused-parameter -Isrc
SANITIZE ?= -fsanitize=address,undefined -fno-omit-frame-pointer

CORE_SRC := $(wildcard src/core/*.c) $(wildcard src/loader/*.c) $(wildcard src/cpu/*.c) $(wildcard src/hle/*.c) $(wildcard src/gpu/*.c)
CLI_SRC  := $(CORE_SRC) src/frontend/app.c src/frontend/filelist.c src/host/main.c
TEST_SRC := $(CORE_SRC) src/frontend/filelist.c $(wildcard tests/*.c)

PPC_CC   ?= powerpc-linux-gnu-gcc
WIN_CC   ?= x86_64-w64-mingw32-gcc
QEMU_PPC ?= qemu-ppc

.PHONY: all test test-ppc eboot cli-ppc win clean

all: $(OUT)/wiisp-cli

$(OUT)/wiisp-cli: $(CLI_SRC) $(wildcard src/*/*.h)
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) -pthread -o $@ $(CLI_SRC) -lm

win: build-win/wiisp-cli.exe

build-win/wiisp-cli.exe: $(CLI_SRC) $(wildcard src/*/*.h)
	@mkdir -p build-win
	$(WIN_CC) -O2 -std=gnu11 -fwrapv -Wall -Wextra -Wno-unused-parameter -Isrc -D__USE_MINGW_ANSI_STDIO=1 \
		-static -o $@ $(CLI_SRC) -lm

$(OUT)/tests: $(TEST_SRC) $(wildcard src/*/*.h tests/*.h)
	@mkdir -p $(OUT)
	$(CC) $(CFLAGS) $(SANITIZE) -o $@ $(TEST_SRC) -lm

test: $(OUT)/tests
	./$(OUT)/tests

eboot: $(OUT)/tests
	./$(OUT)/tests --write-pbp $(OUT)/EBOOT.PBP

$(OUT)/tests-ppc: $(TEST_SRC) $(wildcard src/*/*.h tests/*.h)
	@mkdir -p $(OUT)
	$(PPC_CC) -O2 -std=gnu11 -fwrapv -Wall -Wextra -Wno-unused-parameter -Isrc -static -o $@ $(TEST_SRC) -lm

# CLI para PowerPC big-endian (se ejecuta con qemu-ppc)
cli-ppc: $(OUT)/wiisp-cli-ppc

$(OUT)/wiisp-cli-ppc: $(CLI_SRC) $(wildcard src/*/*.h)
	@mkdir -p $(OUT)
	$(PPC_CC) -O2 -std=gnu11 -fwrapv -Wall -Wextra -Wno-unused-parameter -Isrc -static -pthread -o $@ $(CLI_SRC) -lm

test-ppc: $(OUT)/tests-ppc
	$(QEMU_PPC) ./$(OUT)/tests-ppc

clean:
	rm -rf $(OUT)
